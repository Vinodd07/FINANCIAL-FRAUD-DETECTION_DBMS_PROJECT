CREATE CONSTRAINT c_id IF NOT EXISTS
FOR (n:Customer) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT c_email IF NOT EXISTS
FOR (n:Customer) REQUIRE n.email IS UNIQUE;

CREATE CONSTRAINT a_id IF NOT EXISTS
FOR (n:Account) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT a_no IF NOT EXISTS
FOR (n:Account) REQUIRE n.acc_no IS UNIQUE;

CREATE CONSTRAINT b_ifsc IF NOT EXISTS
FOR (n:Branch) REQUIRE n.ifsc IS UNIQUE;

CREATE CONSTRAINT d_hash IF NOT EXISTS
FOR (n:Device) REQUIRE n.hash IS UNIQUE;

CREATE CONSTRAINT i_ip IF NOT EXISTS
FOR (n:IPAddress) REQUIRE n.ip IS UNIQUE;

CREATE CONSTRAINT l_id IF NOT EXISTS
FOR (n:Login) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT s_tok IF NOT EXISTS
FOR (n:Session) REQUIRE n.token IS UNIQUE;

CREATE CONSTRAINT t_id IF NOT EXISTS
FOR (n:Transaction) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT e_id IF NOT EXISTS
FOR (n:Employee) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT ad_id IF NOT EXISTS
FOR (n:AuditLog) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT case_id IF NOT EXISTS
FOR (n:FraudCase) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT card_id IF NOT EXISTS
FOR (n:BankCard) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT loan_id IF NOT EXISTS
FOR (n:Loan) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT notif_id IF NOT EXISTS
FOR (n:Notification) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT ticket_id IF NOT EXISTS
FOR (n:SupportTicket) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT ben_id IF NOT EXISTS
FOR (n:Beneficiary) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT role_name IF NOT EXISTS
FOR (n:Role) REQUIRE n.name IS UNIQUE;

CREATE CONSTRAINT dept_id IF NOT EXISTS
FOR (n:Department) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT branch_id IF NOT EXISTS
FOR (n:Branch) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT factor_id IF NOT EXISTS
FOR (n:FraudFactor) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT otp_id IF NOT EXISTS
FOR (n:OTPChallenge) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT complaint_id IF NOT EXISTS
FOR (n:Complaint) REQUIRE n.id IS UNIQUE;

